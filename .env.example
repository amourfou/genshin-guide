# WordCatch / ShortJapan / HaanRiver 와 같은 Supabase 프로젝트를 씁니다.
# Supabase 키는 서버(API 라우트)에서만 씁니다. 브라우저에는 어떤 Supabase 키도 들어가지 않습니다.
# 공략 표는 lib/guides.ts 가 기본이고, genshin_guides 행이 있을 때만 그 캐릭터를 덮어씁니다.

# Supabase 대시보드 > Project Settings > API 의 Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# 같은 화면의 service_role 키 (secret). 절대 NEXT_PUBLIC_ 로 시작하는 이름에 넣지 않습니다.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 파티 전투 설명(/api/party-combat)에 씁니다. 없으면 그 기능만 꺼집니다.
OPENAI_API_KEY=your-openai-api-key

# 선택: 로그인 세션 서명 키. 없으면 SUPABASE_SERVICE_ROLE_KEY 에서 만듭니다.
# 바꾸면 모든 기기가 다시 로그인합니다.
# SESSION_SECRET=long-random-string

# 더 이상 쓰지 않습니다: NEXT_PUBLIC_SUPABASE_ANON_KEY
